#USE: Utils as U
#USE: Sys as S

#GLOBAL: Settings
  let project_name = "XyPriss Demo"
  let target_dir = "demo_project"

  U.LOG: "<cyan>[INIT]</> Starting Full Syntax Test for <white>{project_name}</>"

  // 1. Structural Scoping
  #SELECT: {target_dir} as ROOT
  U.LOG: "  <blue>→ Sandbox set to:</> {ROOT}"

  // 2. Inclusion
  #INCLUDE: sub_rules.xru
  U.LOG: "  <magenta>[SUB CHECK]</> Variable from sub: {sub_var}"

  // 3. File Creation
  #CREATE: docs/README.md
    # Documentation for {project_name}
    Created by XRU Full Syntax Test.
    Base: {ROOT}
  #END

  // 4. File Patching (JSON)
  #BEGIN: config.json as CFG
    U.LOG: "  <yellow>[PATCH]</> Updating {CFG}..."
    SET theme "dark"
    PUSH features "logging"
    PUSH features "monitoring"
    REMOVE features "auth"
  #END

  // 5. Global Patching
  #GLOBAL
    ~~ "Hello" "Bonjour"
  #END

// 6. Native Execution & Capture
S.EXEC: "ls -R docs" as DOC_LIST
U.LOG: "  <gray>[FILESYSTEM]</> Docs created:\n{DOC_LIST}"

// 7. Code Injection
#BEGIN: src/main.ts
  @TSINJECT: imports
  import { Logger } from "@xypriss/sys";
  @END
#END

// 8. Assertion
#BEGIN: config.json
  U.ASSERT: "theme == 'dark'"
#END

U.LOG: "\n<green>[SUCCESS]</> Full Syntax Test completed for {project_name,
  "theme": "dark",
}!"
