{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(\\{|\\[|#(BEGIN|CREATE):).*$",
    "decreaseIndentPattern": "^\\s*(\\}|\\]|#END).*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*#(BEGIN|CREATE):.*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*(MERGE|SET|PUSH).*$",
      "action": { "indent": "indent" }
    }
  ]
}
