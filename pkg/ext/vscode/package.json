{
  "name": "xru-syntax",
  "displayName": "XyPriss Rule Unit (XRU) Syntax",
  "description": "Syntax highlighting for XRU (.xru) transformation rules.",
  "version": "0.1.0",
  "publisher": "nehonix",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:xru",
    "onLanguage:markdown"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "xru",
        "aliases": [
          "XRU",
          "xru"
        ],
        "extensions": [
          ".xru"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xru",
        "scopeName": "source.xru",
        "path": "./syntaxes/xru.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.js": "javascript",
          "source.json": "json",
          "source.css": "css",
          "source.go": "go",
          "text.html.basic": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "xru",
        "path": "./snippets/xru.code-snippets"
      },
      {
        "language": "markdown",
        "path": "./snippets/xru.code-snippets"
      }
    ],

    "problemMatchers": [
      {
        "name": "xru",
        "owner": "xru",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nehonix-Team/xru"
  }
}
