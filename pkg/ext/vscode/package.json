{
  "name": "xru-syntax",
  "displayName": "XyPriss Rule Unit (XRU) Syntax",
  "description": "Rich language intelligence, Go-to-Definition, and syntax highlighting for XRU 2.0 transformation rules.",
  "version": "0.6.4",
  "publisher": "nehonix",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:xru",
    "onLanguage:xru-mod",
    "onLanguage:markdown",
    "workspaceContains:**/*.xru"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "xru-icons",
        "label": "XRU File Icons",
        "path": "./icons/xru-icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "xru",
        "aliases": [
          "XRU",
          "xru"
        ],
        "extensions": [
          ".xru"
        ],
        "icon": {
          "dark": "./assets/xru-dark.svg",
          "light": "./assets/xru-light.svg"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "xru-mod",
        "aliases": [
          "XRU Module Config",
          "xru-mod"
        ],
        "filenames": [
          "_mod.xru"
        ],
        "icon": {
          "dark": "./assets/xru-mod-dark.svg",
          "light": "./assets/xru-mod-light.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xru",
        "scopeName": "source.xru",
        "path": "./syntaxes/xru.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.js": "javascript",
          "source.json": "json",
          "source.css": "css",
          "source.go": "go",
          "text.html.basic": "html"
        }
      },
      {
        "language": "xru-mod",
        "scopeName": "source.xru",
        "path": "./syntaxes/xru.tmLanguage.json",
        "embeddedLanguages": {
          "source.ts": "typescript",
          "source.js": "javascript",
          "source.json": "json",
          "source.css": "css",
          "source.go": "go",
          "text.html.basic": "html"
        }
      }
    ],
    "snippets": [
      {
        "language": "xru",
        "path": "./snippets/xru.code-snippets"
      },
      {
        "language": "xru-mod",
        "path": "./snippets/xru.code-snippets"
      },
      {
        "language": "markdown",
        "path": "./snippets/xru.code-snippets"
      }
    ],
    "problemMatchers": [
      {
        "name": "xru",
        "owner": "xru",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+): (error|warning): (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nehonix-Team/xru"
  },
  "scripts": {
    "build:ext": "bash ./build.sh"
  }
}
