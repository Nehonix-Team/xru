{
  "Xru Use Module": {
    "prefix": "use",
    "body": [
      "use ${1:std}"
    ],
    "description": "Import a native or external unit module"
  },
  "Xru Arg Declaration": {
    "prefix": "arg",
    "body": [
      "arg ${1:name}: ${2|string,number,bool,duration|} = ${3:default}"
    ],
    "description": "Declare a configurable CLI argument"
  },
  "Xru Let Declaration": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:string} = ${3:value}"
    ],
    "description": "Declare a local variable"
  },
  "Xru Const Declaration": {
    "prefix": "const",
    "body": [
      "const ${1:name}: ${2:string} = ${3:value}"
    ],
    "description": "Declare a constant"
  },
  "Xru Unit Block": {
    "prefix": "unit",
    "body": [
      "unit ${1:TemplateManager} {",
      "\tdeclare ${2:baseDir}: string = \"./src\"",
      "\t",
      "\tfunc ${3:Clean}(${4:target}: string) -> bool {",
      "\t\tFs.remove(\"{&${2:baseDir}}/\\{${4:target}\\}\")",
      "\t\treturn true",
      "\t}",
      "}"
    ],
    "description": "Define a reusable custom unit with properties, directives, and methods"
  },
  "Xru Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2:params}) -> ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "Define a local function"
  },
  "Xru Global Function": {
    "prefix": "global func",
    "body": [
      "global func ${1:name}(${2:params}) -> ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "Define a global cross-module function"
  },
  "Xru With Block": {
    "prefix": "with",
    "body": [
      "with Net.fetch(\"${1:https://api.github.com/repos/...}\") {",
      "\tset method = \"GET\"",
      "\tset timeout = 30s",
      "\tset extractTo = \"${2:./src}\"",
      "\t",
      "\theader \"Accept\" -> \"application/vnd.github.v3+json\"",
      "\theader \"User-Agent\" -> \"XRU-Engine\"",
      "\t",
      "\ton progress -> (percent, speed) => std.println(\"<cyan>[PROGRESS]</> {percent}% à {speed}\")",
      "\ton complete -> (data, err) => {",
      "\t\tif err != nil {",
      "\t\t\tstd.println(\"<red>[ERROR]</> {err}\")",
      "\t\t} else {",
      "\t\t\tstd.println(\"<green>[DONE]</> Download complete!\")",
      "\t\t\t$0",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Execute a contextual Net.fetch streaming request"
  },
  "Xru File Surgical Block": {
    "prefix": "file",
    "body": [
      "file \"${1:package.json}\" {",
      "\treplace(\"{{NAME}}\", ${2:name})",
      "\t$0",
      "}"
    ],
    "description": "Surgically edit a file in place"
  },
  "Xru If Block": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "Conditional if block"
  },
  "Xru If Else Block": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "Conditional if / else block"
  },
  "Xru If Elif Else Block": {
    "prefix": "ifelif",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "} elif ${3:condition} {",
      "\t$4",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "Conditional if / elif / else block"
  },
  "Xru Match Block": {
    "prefix": "match",
    "body": [
      "match ${1:target} {",
      "\tcase ${2:pattern} {",
      "\t\t$3",
      "\t}",
      "\tdefault {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Pattern matching block"
  },
  "Xru Dispatch Tree Block": {
    "prefix": "dispatch_tree",
    "body": [
      "dispatch_tree \"${1:./src}\", \"${2:.rules.xru}\" {",
      "\tpass ${3:MODE} = ${4:mode}",
      "\t$0",
      "}"
    ],
    "description": "Cascade execution through recursive subdescriptors"
  },
  "Xru Log": {
    "prefix": "log",
    "body": [
      "std.println(\"${1:message}\")"
    ],
    "description": "Log colored message to terminal"
  },
  "Xru Map": {
    "prefix": "map",
    "body": [
      "map {",
      "\t${1:services} -> \"${2:./src/services/*}\"",
      "}"
    ],
    "description": "Map module alias to directory path"
  },
  "Xru Mod": {
    "prefix": "mod",
    "body": [
      "mod ${1:name}"
    ],
    "description": "Declare file module identity"
  },
  "Xru From Use": {
    "prefix": "from",
    "body": [
      "from \"${1:services}\" use ${2:module} as ${3:alias}"
    ],
    "description": "Import a module from mapped path"
  },
  "Xru From Use Member": {
    "prefix": "fromm",
    "body": [
      "from \"${1:services}\" use ${2:module}::${3:member}"
    ],
    "description": "Import a member from module"
  }
}
