{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XyPriss Rule Unit",
  "scopeName": "source.xru",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#directives" },
    { "include": "#strings_heredoc_chevron" },
    { "include": "#strings_heredoc_triple" },
    { "include": "#strings_backtick" },
    { "include": "#strings" },
    { "include": "#keywords_control" },
    { "include": "#keywords_declaration" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions_call" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#durations" },
    { "include": "#operators" },
    { "include": "#global_access" },
    { "include": "#prop_access" },
    { "include": "#unit_instantiation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xru",
          "match": "//.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(use)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.xru" },
            "2": { "name": "entity.name.namespace.module.xru" },
            "3": { "name": "keyword.control.as.xru" },
            "4": { "name": "variable.other.readwrite.alias.xru" }
          }
        },
        {
          "match": "\\b(use)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.import.xru" },
            "2": { "name": "variable.other.readwrite.module.xru" }
          }
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "\\b(set)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)",
          "captures": {
            "1": { "name": "keyword.other.directive.xru" },
            "2": { "name": "variable.other.property.directive.xru" }
          }
        },
        {
          "match": "\\b(on)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=->)",
          "captures": {
            "1": { "name": "keyword.other.directive.xru" },
            "2": { "name": "entity.name.function.event.xru" }
          }
        },
        {
          "name": "keyword.other.directive.xru",
          "match": "\\b(set|header|on)\\b"
        }
      ]
    },
    "strings_heredoc_chevron": {
      "name": "string.quoted.triple.chevron.xru",
      "begin": "<<<",
      "end": ">>>",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "strings_heredoc_triple": {
      "name": "string.quoted.triple.double.xru",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "strings_backtick": {
      "name": "string.template.xru",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#interpolation" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.xru",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.xru",
          "match": "\\\\."
        },
        { "include": "#interpolation" }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.xru",
          "match": "(\\{)(&?)([a-zA-Z_][a-zA-Z0-9_]*)(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.variable.begin.xru" },
            "2": { "name": "punctuation.definition.variable.prop.xru" },
            "3": { "name": "variable.other.interpolation.xru" },
            "4": { "name": "punctuation.definition.variable.end.xru" }
          }
        }
      ]
    },
    "keywords_declaration": {
      "patterns": [
        {
          "name": "keyword.declaration.xru",
          "match": "\\b(let|const|arg|declare|unit|func|directive|global)\\b"
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.xru",
          "match": "\\b(if|elif|else|match|case|default|return|with|file|dispatch_tree|pass)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.xru",
          "match": "\\b(string|number|bool|duration|any|list|map|void)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.builtin.xru",
          "match": "\\b(Utils|Fs|Net|Crypto|Local|Sys|Path)\\b"
        },
        {
          "name": "support.function.builtin.xru",
          "match": "\\b(replace|replaceLine|remove|removeLines|removeBlock|removeUntil|commentOut|append|prepend|jsonSet|jsonRemove|Drop|drop|Keep|keep)\\b(?=\\()"
        }
      ]
    },
    "functions_call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.xru" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.xru",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.xru",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.xru",
          "match": "\\b[0-9]+(?:ms|s|m|h|d)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xru",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.xru",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.comparison.xru",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.xru",
          "match": "="
        },
        {
          "name": "keyword.operator.logical.xru",
          "match": "!|&&|\\|\\||\\bor\\b"
        }
      ]
    },
    "global_access": {
      "patterns": [
        {
          "match": "(::|global::)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.scope.xru" },
            "2": { "name": "entity.name.function.global.xru" }
          }
        }
      ]
    },
    "prop_access": {
      "patterns": [
        {
          "match": "(&)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.variable.prop.xru" },
            "2": { "name": "variable.other.property.xru" }
          }
        }
      ]
    },
    "unit_instantiation": {
      "patterns": [
        {
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.unit.at.xru" },
            "2": { "name": "entity.name.class.unit.xru" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.xru",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
