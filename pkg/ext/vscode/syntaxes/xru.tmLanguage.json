{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XyPriss Rule Unit",
  "scopeName": "source.xru",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#directives" },
    { "include": "#strings_heredoc_chevron" },
    { "include": "#strings_heredoc_triple" },
    { "include": "#strings_backtick" },
    { "include": "#strings" },
    { "include": "#strings_single" },
    { "include": "#loops" },
    { "include": "#keywords_control" },
    { "include": "#keywords_declaration" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#functions_call" },
    { "include": "#constants" },
    { "include": "#durations" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#global_access" },
    { "include": "#prop_access" },
    { "include": "#unit_instantiation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xru",
          "match": "//.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(from|use|as|mod|map|export|import)\\b",
          "name": "keyword.control.xru"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "\\b(set)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?==)",
          "captures": {
            "1": { "name": "keyword.other.directive.xru" },
            "2": { "name": "variable.other.property.directive.xru" }
          }
        },
        {
          "match": "\\b(on)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=->)",
          "captures": {
            "1": { "name": "keyword.other.directive.xru" },
            "2": { "name": "entity.name.function.event.xru" }
          }
        },
        {
          "name": "keyword.other.directive.xru",
          "match": "\\b(set|header|on)\\b"
        }
      ]
    },
    "color_tags": {
      "patterns": [
        {
          "match": "(</?)(red|green|yellow|blue|magenta|cyan|gray|white|bold|underline|reset)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.xru" },
            "2": { "name": "entity.name.tag.color.xru" },
            "3": { "name": "punctuation.definition.tag.xru" }
          }
        },
        {
          "name": "entity.name.tag.color.xru punctuation.definition.tag.xru",
          "match": "</>"
        }
      ]
    },
    "strings_heredoc_chevron": {
      "name": "string.quoted.triple.chevron.xru",
      "begin": "<<<",
      "end": ">>>",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#color_tags" }
      ]
    },
    "strings_heredoc_triple": {
      "name": "string.quoted.triple.double.xru",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#color_tags" }
      ]
    },
    "strings_backtick": {
      "name": "string.template.xru",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#interpolation" },
        { "include": "#color_tags" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.xru",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.xru",
          "match": "\\\\."
        },
        { "include": "#interpolation" },
        { "include": "#color_tags" }
      ]
    },
    "strings_single": {
      "name": "string.quoted.single.xru",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.xru",
          "match": "\\\\."
        },
        { "include": "#interpolation" },
        { "include": "#color_tags" }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.template.expression.xru",
          "begin": "(\\$f)(\\{)",
          "end": "\\}",
          "beginCaptures": {
            "1": { "name": "keyword.other.template.xru punctuation.definition.template-expression.begin.xru" },
            "2": { "name": "punctuation.section.embedded.begin.xru" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.xru punctuation.definition.template-expression.end.xru" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#strings_single" },
            { "include": "#prop_access" },
            { "include": "#builtins" },
            { "include": "#functions_call" },
            { "include": "#operators" },
            { "include": "#numbers" },
            { "include": "#identifiers" }
          ]
        }
      ]
    },
    "keywords_declaration": {
      "patterns": [
        {
          "match": "\\b(interface)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(@map)?",
          "captures": {
            "1": { "name": "keyword.declaration.xru" },
            "2": { "name": "entity.name.type.class.xru" },
            "3": { "name": "storage.type.map.xru" }
          }
        },
        {
          "match": "\\b(unit)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+(includes|extends)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.declaration.xru" },
            "2": { "name": "entity.name.type.class.xru" },
            "3": { "name": "keyword.other.xru" },
            "4": { "name": "entity.name.type.class.xru" }
          }
        },
        {
          "name": "keyword.declaration.xru",
          "match": "\\b(let|const|arg|declare|unit|func|directive|global|interface|type|includes|extends)\\b"
        }
      ]
    },
    "loops": {
      "patterns": [
        {
          "match": "\\b(for)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*,\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.loop.xru" },
            "2": { "name": "variable.parameter.loop.xru" },
            "3": { "name": "variable.parameter.loop.xru" },
            "4": { "name": "keyword.control.loop.xru" }
          }
        },
        {
          "match": "\\b(for)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.loop.xru" },
            "2": { "name": "variable.parameter.loop.xru" },
            "3": { "name": "keyword.control.loop.xru" }
          }
        },
        {
          "match": "\\b(while)\\b",
          "name": "keyword.control.loop.xru"
        }
      ]
    },
    "keywords_control": {
      "patterns": [
        {
          "name": "keyword.control.xru",
          "match": "\\b(if|elif|else|match|case|default|for|while|in|return|with|catch|or|then|file|dispatch|dispatch_tree|pass)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.xru",
          "match": "\\b(string|number|bool|duration|any|list|map|void|never|task)\\b|@map"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.class.builtin.xru",
          "match": "\\b(std|Std|Fs|Net|Crypto|Local|Sys|Path|Json|Math|date|Date)\\b"
        },
        {
          "name": "support.function.builtin.xru",
          "match": "\\b(println|print|info|success|warn|error|sleep|fatal|exit|replace|replaceLine|remove|removeLines|removeBlock|removeUntil|commentOut|append|prepend|jsonSet|jsonRemove|Drop|drop|Keep|keep)\\b(?=\\()"
        }
      ]
    },
    "functions_call": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.xru" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.xru",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.xru",
          "match": "\\b(nil|null)\\b"
        }
      ]
    },
    "durations": {
      "patterns": [
        {
          "name": "constant.numeric.duration.xru",
          "match": "\\b[0-9]+(?:ms|s|m|h|d)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xru",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.range.xru",
          "match": "\\.\\."
        },
        {
          "name": "punctuation.accessor.scope.xru",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.xru",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.arithmetic.xru",
          "match": "\\+|\\-|\\*|\\/|%"
        },
        {
          "name": "keyword.operator.comparison.xru",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.xru",
          "match": "=:|="
        },
        {
          "name": "keyword.operator.logical.xru",
          "match": "!|&&|\\|\\||\\bor\\b"
        },
        {
          "name": "keyword.operator.optional.xru",
          "match": "\\?"
        }
      ]
    },
    "global_access": {
      "patterns": [
        {
          "match": "(::|global::)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.scope.xru" },
            "2": { "name": "entity.name.function.global.xru" }
          }
        }
      ]
    },
    "prop_access": {
      "patterns": [
        {
          "match": "(&)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.property.xru punctuation.definition.variable.prop.xru" },
            "2": { "name": "variable.other.property.xru" }
          }
        }
      ]
    },
    "unit_instantiation": {
      "patterns": [
        {
          "match": "(@map)\\b",
          "captures": {
            "1": { "name": "storage.type.map.xru entity.name.type.xru" }
          }
        },
        {
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.unit.at.xru" },
            "2": { "name": "entity.name.class.unit.xru" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.xru variable.other.xru",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
