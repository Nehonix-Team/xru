{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XyPriss Rule Unit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#create_html" },
    { "include": "#create_json" },
    { "include": "#create_js" },
    { "include": "#create_ts" },
    { "include": "#create_css" },
    { "include": "#create_go" },
    { "include": "#scoping" },
    { "include": "#modular_actions" },
    { "include": "#functions" },
    { "include": "#inject_ts" },
    { "include": "#inject_js" },
    { "include": "#inject_go" },
    { "include": "#inject_json" },
    { "include": "#inject_css" },
    { "include": "#inject_html" },
    { "include": "#actions_generic" },
    { "include": "#patch_ops" },
    { "include": "#paths" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#interpolation" },
    { "include": "#variable_capture" },
    { "include": "#variable_declaration" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.double-slash.xru", "match": "//.*$" }]
    },
    "scoping": {
      "patterns": [
        {
          "name": "keyword.control.scoping.xru",
          "match": "^#(BEGIN|CREATE|SELECT|GLOBAL|USE|INCLUDE):"
        },
        { "name": "keyword.control.scoping.end.xru", "match": "^#END(:.*)?$" }
      ]
    },
    "modular_actions": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*):",
          "captures": {
            "1": { "name": "variable.other.object.xru" },
            "2": { "name": "entity.name.function.method.xru" }
          }
        }
      ]
    },
    "inject_ts": {
      "begin": "^(@TSINJECT):",
      "beginCaptures": { "0": { "name": "entity.name.tag.xru" } },
      "end": "^(@END)$",
      "endCaptures": { "1": { "name": "entity.name.tag.xru" } },
      "patterns": [{ "include": "source.ts" }]
    },
    "inject_js": {
      "begin": "^(@JSINJECT):",
      "beginCaptures": { "0": { "name": "entity.name.tag.xru" } },
      "end": "^(@END)$",
      "endCaptures": { "1": { "name": "entity.name.tag.xru" } },
      "patterns": [{ "include": "source.js" }]
    },
    "inject_go": {
      "begin": "^(@GOINJECT):",
      "beginCaptures": { "0": { "name": "entity.name.tag.xru" } },
      "end": "^(@END)$",
      "endCaptures": { "1": { "name": "entity.name.tag.xru" } },
      "patterns": [{ "include": "source.go" }]
    },
    "inject_json": {
      "begin": "^(@JSONINJECT):",
      "beginCaptures": { "0": { "name": "entity.name.tag.xru" } },
      "end": "^(@END)$",
      "endCaptures": { "1": { "name": "entity.name.tag.xru" } },
      "patterns": [{ "include": "source.json" }]
    },
    "inject_css": {
      "begin": "^(@CSSINJECT):",
      "beginCaptures": { "0": { "name": "entity.name.tag.xru" } },
      "end": "^(@END)$",
      "endCaptures": { "1": { "name": "entity.name.tag.xru" } },
      "patterns": [{ "include": "source.css" }]
    },
    "inject_html": {
      "begin": "^(@HTMLINJECT):",
      "beginCaptures": { "0": { "name": "entity.name.tag.xru" } },
      "end": "^(@END)$",
      "endCaptures": { "1": { "name": "entity.name.tag.xru" } },
      "patterns": [{ "include": "text.html.basic" }]
    },
    "actions_generic": {
      "patterns": [
        {
          "name": "keyword.control.action.inject.xru",
          "match": "^@[A-Z]*INJECT:",
          "captures": { "0": { "name": "entity.name.tag.xru" } }
        },
        {
          "name": "keyword.control.action.end.xru",
          "match": "^@END$",
          "captures": { "0": { "name": "entity.name.tag.xru" } }
        }
      ]
    },
    "patch_ops": {
      "patterns": [
        {
          "name": "keyword.operator.patch.symbol.xru",
          "match": "^\\s*(\\+\\+|--|>>|<<|~~)"
        },
        {
          "name": "entity.name.function.action.xru",
          "match": "\\b(MERGE|SET|REMOVE|PUSH|merge|set|rm|remove|push)\\b"
        },
        {
          "name": "keyword.operator.patch.legacy.xru",
          "match": "&(merge|add|rm|rp-k|rp-0|rp-v|rp-1|append|regex):"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xru",
          "begin": "\"", "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.xru", "match": "\\\\." },
            { "include": "#interpolation" },
            { "include": "#log_colors" }
          ]
        },
        {
          "name": "string.quoted.single.xru",
          "begin": "'", "end": "'",
          "patterns": [
            { "name": "constant.character.escape.xru", "match": "\\\\." },
            { "include": "#interpolation" },
            { "include": "#log_colors" }
          ]
        }
      ]
    },
    "log_colors": {
      "patterns": [
        {
          "name": "constant.other.color.xru",
          "match": "<(red|green|yellow|blue|magenta|cyan|gray|white|/)>"
        }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.xru", "match": "\\b\\d+(\\.\\d+)?\\b" }]
    },
    "constants": {
      "patterns": [{ "name": "constant.language.xru", "match": "\\b(true|false|null)\\b" }]
    },
    "functions": {
      "patterns": [{ "name": "entity.name.function.xru", "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\()" }]
    },
    "create_html": {
      "begin": "^#CREATE:.*\\.html$",
      "beginCaptures": { "0": { "name": "keyword.control.scoping.xru" } },
      "end": "^#END",
      "endCaptures": { "0": { "name": "keyword.control.scoping.end.xru" } },
      "patterns": [{ "include": "text.html.basic" }]
    },
    "create_json": {
      "begin": "^#CREATE:.*\\.json$",
      "beginCaptures": { "0": { "name": "keyword.control.scoping.xru" } },
      "end": "^#END",
      "endCaptures": { "0": { "name": "keyword.control.scoping.end.xru" } },
      "patterns": [{ "include": "source.json" }]
    },
    "create_js": {
      "begin": "^#CREATE:.*\\.js$",
      "beginCaptures": { "0": { "name": "keyword.control.scoping.xru" } },
      "end": "^#END",
      "endCaptures": { "0": { "name": "keyword.control.scoping.end.xru" } },
      "patterns": [{ "include": "source.js" }]
    },
    "create_ts": {
      "begin": "^#CREATE:.*\\.ts$",
      "beginCaptures": { "0": { "name": "keyword.control.scoping.xru" } },
      "end": "^#END",
      "endCaptures": { "0": { "name": "keyword.control.scoping.end.xru" } },
      "patterns": [{ "include": "source.ts" }]
    },
    "create_css": {
      "begin": "^#CREATE:.*\\.css$",
      "beginCaptures": { "0": { "name": "keyword.control.scoping.xru" } },
      "end": "^#END",
      "endCaptures": { "0": { "name": "keyword.control.scoping.end.xru" } },
      "patterns": [{ "include": "source.css" }]
    },
    "create_go": {
      "begin": "^#CREATE:.*\\.go$",
      "beginCaptures": { "0": { "name": "keyword.control.scoping.xru" } },
      "end": "^#END",
      "endCaptures": { "0": { "name": "keyword.control.scoping.end.xru" } },
      "patterns": [{ "include": "source.go" }]
    },
    "variable_capture": {
      "patterns": [
        {
          "match": "\\b(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.unit.xru" },
            "2": { "name": "variable.other.xru" }
          }
        }
      ]
    },
    "variable_declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
          "captures": {
            "1": { "name": "keyword.control.declaration.xru" },
            "2": { "name": "variable.other.xru" }
          }
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "variable.interpolation.xru",
          "match": "\\{[a-zA-Z_][a-zA-Z0-9_]*\\}"
        }
      ]
    },
    "paths": {
      "patterns": [{ "name": "variable.other.member.xru", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)+\\b" }]
    }
  },
  "scopeName": "source.xru"
}
