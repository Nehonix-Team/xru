{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XyPriss Rule Unit",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#inception"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#create_html"
    },
    {
      "include": "#create_json"
    },
    {
      "include": "#create_js"
    },
    {
      "include": "#create_ts"
    },
    {
      "include": "#create_css"
    },
    {
      "include": "#create_go"
    },
    {
      "include": "#modular_actions"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#inject_ts"
    },
    {
      "include": "#inject_js"
    },
    {
      "include": "#inject_go"
    },
    {
      "include": "#inject_json"
    },
    {
      "include": "#inject_css"
    },
    {
      "include": "#inject_html"
    },
    {
      "include": "#actions_generic"
    },
    {
      "include": "#patch_ops"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#interpolation"
    },
    {
      "include": "#variable_capture"
    },
    {
      "include": "#variable_declaration"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.xru",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.xru",
          "match": "#\\s*[A-Z]+\\b"
        },
        {
          "name": "keyword.control.xru",
          "match": "#\\s*END\\b"
        }
      ]
    },
    "modular_actions": {
      "patterns": [
        {
          "match": "^\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\.([a-zA-Z_][a-zA-Z0-9_]*):",
          "captures": {
            "1": {
              "name": "variable.other.object.xru"
            },
            "2": {
              "name": "entity.name.function.method.xru"
            }
          }
        }
      ]
    },
    "inject_ts": {
      "begin": "^\\s*(@TSINJECT):\\s*(.*)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#interpolation"
            },
            {
              "name": "string.regexp",
              "match": "/[^/].*/[gimsuy]*"
            },
            {
              "include": "#barewords"
            }
          ]
        }
      },
      "end": "^\\s*(@END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "inject_js": {
      "begin": "^\\s*(@JSINJECT):\\s*(.*)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#interpolation"
            },
            {
              "name": "string.regexp",
              "match": "/[^/].*/[gimsuy]*"
            },
            {
              "include": "#barewords"
            }
          ]
        }
      },
      "end": "^\\s*(@END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        }
      ]
    },
    "inject_go": {
      "begin": "^\\s*(@GOINJECT):\\s*(.*)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#interpolation"
            },
            {
              "name": "string.regexp",
              "match": "/[^/].*/[gimsuy]*"
            },
            {
              "include": "#barewords"
            }
          ]
        }
      },
      "end": "^\\s*(@END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.go"
        }
      ]
    },
    "inject_json": {
      "begin": "^\\s*(@JSONINJECT):\\s*(.*)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#interpolation"
            },
            {
              "name": "string.regexp",
              "match": "/[^/].*/[gimsuy]*"
            },
            {
              "include": "#barewords"
            }
          ]
        }
      },
      "end": "^\\s*(@END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    },
    "inject_css": {
      "begin": "^\\s*(@CSSINJECT):\\s*(.*)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#interpolation"
            },
            {
              "name": "string.regexp",
              "match": "/[^/].*/[gimsuy]*"
            },
            {
              "include": "#barewords"
            }
          ]
        }
      },
      "end": "^\\s*(@END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.css"
        }
      ]
    },
    "inject_html": {
      "begin": "^\\s*(@HTMLINJECT):\\s*(.*)$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#interpolation"
            },
            {
              "name": "string.regexp",
              "match": "/[^/].*/[gimsuy]*"
            },
            {
              "include": "#barewords"
            }
          ]
        }
      },
      "end": "^\\s*(@END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "actions_generic": {
      "patterns": [
        {
          "name": "keyword.control.scoping.if.xru",
          "begin": "^\\s*#\\s*(IF|ELSEIF):",
          "beginCaptures": {
            "0": {
              "name": "keyword.control.scoping.xru"
            }
          }
        },
        {
          "name": "keyword.control.action.inject.xru",
          "match": "^\\s*@[A-Z]*INJECT:",
          "captures": {
            "0": {
              "name": "entity.name.tag.xru"
            }
          }
        },
        {
          "name": "keyword.control.action.end.xru",
          "match": "^\\s*@END$",
          "captures": {
            "0": {
              "name": "entity.name.tag.xru"
            }
          }
        }
      ]
    },
    "patch_ops": {
      "patterns": [
        {
          "name": "keyword.operator.patch.symbol.xru",
          "match": "^\\s*(\\+\\+|--|>>|<<|~~)"
        },
        {
          "name": "entity.name.function.action.xru",
          "match": "\\b(MERGE|SET|REMOVE|PUSH|merge|set|rm|remove|push)\\b"
        },
        {
          "name": "keyword.operator.patch.legacy.xru",
          "match": "&(merge|add|rm|rp-k|rp-0|rp-v|rp-1|append|regex):"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xru",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.xru",
              "match": "\\\\."
            },
            {
              "include": "#log_colors"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.single.xru",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.xru",
              "match": "\\\\."
            },
            {
              "include": "#log_colors"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "log_colors": {
      "patterns": [
        {
          "name": "entity.name.tag.xru",
          "match": "</?(red|green|yellow|blue|magenta|cyan|gray|white|/)>"
        }
      ]
    },
    "barewords": {
      "match": "[a-zA-Z0-9_\\-\\./]+",
      "name": "string.unquoted.path.xru"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.xru",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.xru",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.method.xru",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\()"
        }
      ]
    },
    "create_html": {
      "begin": "^\\s*(#(?:CREATE|BEGIN):)\\s*(?:\"|')?(.*\\.html)(?:\"|')?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "entity.name.filename.xru"
        }
      },
      "end": "^\\s*#END",
      "endCaptures": {
        "0": {
          "name": "keyword.control.scoping.end.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "text.html.basic"
        }
      ]
    },
    "create_json": {
      "begin": "^\\s*(#(?:CREATE|BEGIN):)\\s*(?:\"|')?(.*\\.json)(?:\"|')?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "entity.name.filename.xru"
        }
      },
      "end": "^\\s*#END",
      "endCaptures": {
        "0": {
          "name": "keyword.control.scoping.end.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "source.json"
        }
      ]
    },
    "create_js": {
      "begin": "^\\s*(#(?:CREATE|BEGIN):)\\s*(?:\"|')?(.*\\.js)(?:\"|')?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "entity.name.filename.xru"
        }
      },
      "end": "^\\s*#END",
      "endCaptures": {
        "0": {
          "name": "keyword.control.scoping.end.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "source.js"
        }
      ]
    },
    "create_ts": {
      "begin": "^\\s*(#(?:CREATE|BEGIN):)\\s*(?:\"|')?(.*\\.ts)(?:\"|')?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "entity.name.filename.xru"
        }
      },
      "end": "^\\s*#END",
      "endCaptures": {
        "0": {
          "name": "keyword.control.scoping.end.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "source.ts"
        }
      ]
    },
    "create_css": {
      "begin": "^\\s*(#(?:CREATE|BEGIN):)\\s*(?:\"|')?(.*\\.css)(?:\"|')?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "entity.name.filename.xru"
        }
      },
      "end": "^\\s*#END",
      "endCaptures": {
        "0": {
          "name": "keyword.control.scoping.end.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "source.css"
        }
      ]
    },
    "create_go": {
      "begin": "^\\s*(#(?:CREATE|BEGIN):)\\s*(?:\"|')?(.*\\.go)(?:\"|')?$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "entity.name.filename.xru"
        }
      },
      "end": "^\\s*#END",
      "endCaptures": {
        "0": {
          "name": "keyword.control.scoping.end.xru"
        }
      },
      "patterns": [
        {
          "include": "#inception"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        },
        {
          "include": "source.go"
        }
      ]
    },
    "variable_capture": {
      "patterns": [
        {
          "match": "\\b(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.unit.xru"
            },
            "2": {
              "name": "variable.other.xru"
            }
          }
        }
      ]
    },
    "variable_declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.xru"
            },
            "2": {
              "name": "variable.other.xru"
            }
          }
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "match": "(\\{)([a-zA-Z0-9_\\.]+)(\\})",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.xru"
            },
            "2": {
              "name": "variable.other.xru"
            },
            "3": {
              "name": "punctuation.definition.variable.xru"
            }
          }
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "name": "variable.other.member.xru",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(\\.[a-zA-Z_][a-zA-Z0-9_]*)+\\b"
        }
      ]
    },
    "var_ts": {
      "begin": "^\\s*(#TSVAR):\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "variable.other.xru"
        }
      },
      "end": "^\\s*(#END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.ts"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "var_js": {
      "begin": "^\\s*(#JSVAR):\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "variable.other.xru"
        }
      },
      "end": "^\\s*(#END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.js"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "var_json": {
      "begin": "^\\s*(#JSONVAR):\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "variable.other.xru"
        }
      },
      "end": "^\\s*(#END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      },
      "patterns": [
        {
          "include": "source.json"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "var_generic": {
      "begin": "^\\s*(#VAR):\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        },
        "2": {
          "name": "variable.other.xru"
        }
      },
      "end": "^\\s*(#END)\\s*$",
      "endCaptures": {
        "1": {
          "name": "keyword.control.scoping.xru"
        }
      }
    },
    "inception": {
      "name": "meta.embedded.xru.inception",
      "begin": "<#",
      "end": ">",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.tag.xru"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.tag.xru"
        }
      },
      "patterns": [
        {
          "include": "#keywords"
        },
        {
          "include": "#interpolation"
        },
        {
          "include": "#strings"
        }
      ]
    }
  },
  "scopeName": "source.xru"
}
