// Package cmd provides process execution and shell command runner primitives.

/// Result structure returned by command execution interceptors or cout blocks.
interface CmdResult @map {
	out string
	err string
	code number
	ok bool
}

/// Native shell command runner primitives.
interface CmdNative {
	/// Executes a system shell command and returns its standard output as a string.
	/// Accepts an optional working directory path where the command should be executed.
	func exec(command: string, dir: string = "") -> string
}

unit cmd includes CmdNative {}
