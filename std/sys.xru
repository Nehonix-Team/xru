// Package sys provides operating system inspection and process control.

/// Native operating system inspection and process control primitives.
interface SysNative {
	/// Returns the host operating system name (e.g. "linux", "darwin", "windows").
	func os() -> string

	/// Returns the machine processor architecture (e.g. "amd64", "arm64").
	func arch() -> string

	/// Retrieves the value of an OS environment variable with an optional fallback.
	func getEnv(name: string, fallback: string = "") -> string

	/// Terminates the process immediately with the given exit code (0 by default).
	func exit(code: number = 0) -> never

	/// Pauses current execution for the given duration.
	func sleep(duration: any) -> void

	/// Returns the current time formatted as an ISO-8601 string.
	func time() -> string
}

unit sys includes SysNative {}
