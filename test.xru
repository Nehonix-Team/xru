#USE: Utils as U
#USE: Sys as S
#USE: Sys as S

let app_name = "XyPriss"
let rel = "file.md"

#SELECT: apps/{app_name} as ROOT
U.LOG: "<cyan>[INFO]</> Traitement de <white>{app_name}</> dans <gray>{ROOT}</>\n"

#BEGIN: config.json as C
  let theme = "dark"
  SET ui.theme "{theme}"
  SET metadata.owner "{app_name}"
  
  U.LOG: "  <blue>→ Applying theme:</> {theme} in {C}"
  U.ASSERT: "ui.theme == 'dark'"
  
  S.EXEC: "cat {rel}" as L
  U.LOG: "<yellow>[SCRIPT OUTPUT]</>\n{L}"
#END

U.LOG: "\n<green>[SUCCESS]</> Transformation finished for {app_name}"

// Ici {theme} n'existe plus, mais {app_name} est toujours là
U.LOG: "<red>[EXPECTED ERROR]</> Scoped variable check: {theme}"
