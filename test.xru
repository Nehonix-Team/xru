#USE: Utils as U
#USE: Sys as S

let app_name = "XyPriss"
let rel = "file.md"
let p = "apps/{app_name}"

#CREATE:{p}
  
#END

// Sécurité : XRU vérifiera maintenant que ce dossier existe vraiment
#SELECT: {p} as ROOT
U.LOG: "<cyan>[INFO]</> Traitement de <white>{app_name}</> dans <gray>{ROOT}</>\n"
#BEGIN: config.json as C
  let theme = "dark"
  SET ui.theme "{theme}"
  SET metadata.owner "{app_name}"
  
  U.LOG: "  <blue>→ Applying theme: {theme} in {C}"

  // Nouvelle syntaxe libre et imbriquée (Nesting)
# IF: exists(nonExistent.json)
    U.LOG: "  <green>[OK]</> Validation réussie."
# ELSE:
    U.LOG: "  <red>[FATAL]</> Fichier de configuration critique manquant !"
    U.EXIT: 1
# END
  
  S.EXEC: "cat {rel}" as L
  U.LOG: "<yellow>[SCRIPT OUTPUT]</>\n<red>{L}</>"
#END

U.LOG: "\n<green>[SUCCESS]</> Transformation terminée pour {app_name}"

// Ici {theme} n'existe plus (scope local au bloc #BEGIN)
U.LOG: "<red>[EXPECTED ERROR]</> Scoped variable check: {theme}"

U.LOG: "Attempting to inject script"

@TSINJECT: {{OK}}
  console.log("Injection réussie");
@END
