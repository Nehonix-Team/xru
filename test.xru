let app_name = "XyPriss"

#SELECT: apps/{app_name} as ROOT
#LOG: "Traitement de {app_name} dans {ROOT}\n"

#BEGIN: config.json as C
  let theme = "dark"
  SET ui.theme "{theme}"
  SET metadata.owner "{app_name}"
#LOG: "Affichage de la var theme dans le bloc {C}: {theme}"
#ASSERT: "ui.theme == 'dark'"
#EXEC: "echo 'hello'" as L
#LOG: "script result: {L}"
#END

#INCLUDE: xru as t2
#LOG: "file path: {t2}"

// Ici {theme} n'existe plus, mais {app_name} est toujours là
#LOG: "Log de la variable scopée: {theme}"
