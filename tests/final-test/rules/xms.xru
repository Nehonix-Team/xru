// --------------------------------------------------------------------------
// XyPriss Multi-Server (XMS) Orchestrator
// --------------------------------------------------------------------------

// Import built-in modules
#USE: fs as FS
#USE: utils as U

U.LOG: "<cyan>[INFO]</> Orchestrating in <yellow>XMS</> mode..."

// 1. CLEANUP ENVIRONMENT
// Open .env to remove variables that might conflict with multi-server setup
#BEGIN: ".env"
    // Remove the default PORT variable
    @INJECT: /(?m)^PORT=.*$\n?/
    @END
#END

// Switch context to the source directory
#SELECT: "./src/"

// 2. DATA DEFINITION
// Define the map of servers to be orchestrated
#JSONVAR: SERVERS
{
  "auth": { "route": "/auth", "desc": "Authentication Server", "body": "Auth instance logic." },
  "main": { "route": "/api",  "desc": "Main API Server", "body": "Primary instance.", "extra": "security: { honeypotTarpit: true }," }
}
#END

// 3. CONFIGURATION & ROUTING
// Inject server-specific configurations into the main config file
#BEGIN: "configs/xypriss.config.ts"
    @TSINJECT: SERVERS_IMPORT
        // Loop through servers to generate import statements
        <#FOR: S in {SERVERS}>
        import { {S}Server } from "../servers/{S}.server";
        <#END>
    @END
    
    // Cleanup: Remove unused manifest import using a Regex pattern
    @TSINJECT: /^.*import \{ manifest \}.*$\n?/
    @END
    
    @TSINJECT: SERVER_CONFIG
        // Define the multi-server configuration block
        multiServer: {
            enabled: true,
            servers: [
                <#FOR: S in {SERVERS}>
                {S}Server,
                <#END>
            ],
        },
    @END
#END

// Setup routing for each server module
#BEGIN: "router/index.ts"
    @TSINJECT: ROUTERS_IMPORT
        <#FOR: S in {SERVERS}>
        import { {S}Router } from "../routes/{S}.route";
        <#END>
    @END
    @TSINJECT: ROUTERS_USE
        <#FOR: S in {SERVERS}>
        router.use("{SERVERS.{S}.route}", {S}Router);
        <#END>
    @END
#END

// 4. FILE GENERATION
// Create a shared XMS configuration file
#CREATE: "configs/xms.config.ts"
    export const xmsc: XMSConfig = __sys__.vars.get("xms_nodes");

    interface  XMSConfig {
        auth: {
            id: string;
            port: number;
        };
        main: {
            id: string;
            port: number;
        };
    }
#END

#FOR: S in {SERVERS}
    #CREATE: "servers/{S}.server.ts"
        import { MultiServerConfig } from "xypriss";
        import { xmsc } from "../configs/xms.config";
        
        /** {SERVERS.{S}.desc} */
        export const {S}Server: MultiServerConfig = {
            id: xmsc.{S}.id,
            port: xmsc.{S}.port,
            routePrefix: "{SERVERS.{S}.route}",
            // Include extra security or performance options if defined
            <#IF: {SERVERS.{S}.extra}>
            {SERVERS.{S}.extra}
            <#END>
        };
    #END

    #CREATE: "routes/{S}.route.ts"
        import { Router } from "xypriss";
        
        /** Router for {S} module */
        export const {S}Router = Router();
        
        {S}Router.get("/", (ctx) => { 
            ctx.body = { 
                message: "Welcome {S}", 
                mode: "XMS" 
            }; 
        });
    #END
#END

U.LOG: "<green>[SUCCESS]</> XMS Orchestration complete."
