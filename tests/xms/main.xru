// --------------------------------------------------------------------------
// XyPriss Multi-Server Orchestrator (Compact Edition)
// --------------------------------------------------------------------------
#USE: fs as FS
#USE: utils as U

#ARG: "--mode" as MODE
#IF: {MODE} == ""
    let MODE = "default"
#END

U.LOG: "<cyan>[INFO]</> Orchestrating in <yellow>{MODE}</> mode..."

#SELECT: "./src/"

let SERVERS = {}

// 1. DATA & LOGIC PRE-CALCULATION
#IF: {MODE} == "xms"
    #JSONVAR: SERVERS
    {
      "auth": { "route": "/auth", "desc": "Authentication Server", "body": "Auth instance logic." },
      "main": { "route": "/api",  "desc": "Main API Server", "body": "Primary instance.", "extra": "security: { honeypotTarpit: true }," }
    }
    #END
#ELSE:
    #JSONVAR: SERVERS
    { "main": { "route": "/api", "desc": "Default Server", "body": "Standard instance." } }
    #END
#END

// Pre-build logic is no longer needed thanks to Inception mode!

// 2. CONFIGURATION & ROUTING
#BEGIN: "configs/xypriss.config.ts"
    #IF: {MODE} == "xms"
        @TSINJECT: SERVER_CONFIG
            multiServer: {
                enabled: true,
                servers: [
                    <#FOR: S in {SERVERS}>
                    {S}Server,
                    <#END>
                ],
            },
        @END
    #ELSE:
        @TSINJECT: SERVER_CONFIG
            server: { autoKillConflict: true, port: 8080, serviceName: "default" },
        @END
    #END
#END

#BEGIN: "router/index.ts"
    @TSINJECT: ROUTERS_IMPORT
        <#FOR: S in {SERVERS}>
        import { {S}Router } from "../routes/{S}.route";
        <#END>
    @END
    @TSINJECT: ROUTERS_USE
        <#FOR: S in {SERVERS}>
        router.use("{SERVERS.{S}.route}", {S}Router);
        <#END>
    @END
#END

// 3. GENERATION
#IF: {MODE} == "xms"s
    #CREATE: "configs/xms.config.ts"
        export const xmsc: any = __sys__.vars.get("xms_nodes");
    #END

    #FOR: S in {SERVERS}
        #CREATE: "servers/{S}.server.ts"
            import { MultiServerConfig } from "xypriss";
            import { xmsc } from "../configs/xms.config";
            /** {SERVERS.{S}.desc} */
            export const {S}Server: MultiServerConfig = {
                id: xmsc.{S}.id,
                port: xmsc.{S}.port,
                routePrefix: "{SERVERS.{S}.route}",
                {SERVERS.{S}.extra}
            };
        #END

        #CREATE: "routes/{S}.route.ts"
            import { Router } from "xypriss";
            export const {S}Router = Router();
            {S}Router.get("/", (ctx) => { ctx.body = { message: "Welcome {S}", mode: "{MODE}" }; });
        #END
    #END
#ELSE:
    #CREATE: "routes/main.route.ts"
        import { Router } from "xypriss";
        export const mainRouter = Router();
        mainRouter.get("/", (ctx) => { ctx.body = { message: "Default server" }; });
    #END
#END

U.LOG: "<green>[SUCCESS]</> Orchestration complete."
