#USE: fs as FS
#SELECT: "./src/"

#INCLUDE: "data.xru"
FS.READ_JSON: "servers.json" as CONFIG

let SERVERS = ["auth", "main"]

#FOR: S in {SERVERS}
    #CALL: "template.xru"
        let SERVER = {CONFIG.{S}}        
        let SERVER_NAME = "{S}"
        let SERVER_VAR = "{S}Server"
        let SERVER_ROUTE = {SERVER.route}
        let SERVER_DESC_TITLE = {SERVER.desc}
        let SERVER_DESC_BODY = {SERVER.body}
        
        #IF: {S} == "main"
            let SERVER_EXTRA = {MAIN_EXTRA}
        #ELSE
            let SERVER_EXTRA = {AUTH_EXTRA}
        #END
    #END
#END
