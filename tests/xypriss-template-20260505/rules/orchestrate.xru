// --------------------------------------------------------------------------
// XyPriss Unified Orchestrator (XMS & Default)
// --------------------------------------------------------------------------

// 1. ARGUMENTS & MODULES
#ARG: MODE as "default" 
#ARG: NAME as "my-xypriss-app"
#ARG: VERSION as "1.0.2"
#ARG: DESCRIPTION as "A high-performance XyPriss server."
#ARG: AUTHOR as "Nehonix-Team"

#USE: utils as U
#USE: fs as FS
#USE: sys as S

U.LOG: "<cyan>[INFO]</> Orchestrating <bold>{NAME}</> (v{VERSION}) in <yellow>{MODE}</> mode..."

// 2. METADATA REPLACEMENT
// Update project metadata in package.json and README.md
#BEGIN: "package.json"
    ~~ /\{\{NAME\}\}/ -> {NAME}
    ~~ /\{\{VERSION\}\}/ -> {VERSION}
    ~~ /\{\{DESCRIPTION\}\}/ -> {DESCRIPTION}
    ~~ /\{\{AUTHOR\}\}/ -> {AUTHOR}
#END

#BEGIN: "README.md"
    ~~ /\{\{SERVER_NAME\}\}/ -> {NAME}
    ~~ /\{\{DESCRIPTION\}\}/ -> {DESCRIPTION}
    ~~ /\{\{AUTHOR\}\}/ -> {AUTHOR}
#END

// 3. DATA DEFINITION
#JSONVAR: DATA
{
  "xms": {
    "auth": { "route": "/auth", "desc": "Auth Server" },
    "main": { "route": "/api",  "desc": "Main Server", "extra": "security: { honeypotTarpit: true }," }
  },
  "default": {
    "main": { "route": "/api",  "desc": "Default Server" }
  }
}
#END

// Extract the specific configuration based on the selected MODE
let SERVERS = {DATA.{MODE}}

// 4. MODULAR ORCHESTRATION
// Include the specific rules based on the selected mode
#IF: {MODE} == "xms"
    #INCLUDE: "xms.xru"
#ELSE
    #INCLUDE: "default.xru"
#END

// 5. FINALIZATION & CLEANUP
U.LOG: "<green>[SUCCESS]</> {MODE} Orchestration complete."
U.LOG: "<yellow>[CLEANUP]</> Removing rules directory..."

S.GET: "CWD" as CURRENT_CWD

// FS.RM is cross-platform and handles both Windows and Unix-like systems
FS.RM: "rules"
S.EXEC: "ls -lr ./*" as R
U.LOG: "Result for cmd: <blue>{R}</>"
U.LOG: "Final project path: <red>{CURRENT_CWD}</>"
