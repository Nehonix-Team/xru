// --------------------------------------------------------------------------
// XyPriss XMS Mode Rules
// --------------------------------------------------------------------------

// 1. CLEANUP ENVIRONMENT
// Open .env to remove variables that might conflict with multi-server setup
#BEGIN: ".env"
    // Remove the default PORT variable
    @INJECT: /(?m)^PORT=.*$\n?/
    @END
#END

// 2. CODE INJECTIONS
#SELECT: "./src/"

#BEGIN: "configs/xypriss.config.ts"
    @TSINJECT: SERVERS_IMPORT
        /**
         * Server instances imports for XMS orchestration.
         * These are dynamically generated based on the selected mode.
         */
        <#FOR: S in {SERVERS}>
        import { {S}Server } from "../servers/{S}.server";
        <#END>
    @END
    
    @TSINJECT: SERVER_CONFIG
        /**
         * Multi-server configuration block.
         * This enables high-performance orchestration of multiple isolated instances.
         */
        multiServer: {
            enabled: true,
            servers: [
                <#FOR: S in {SERVERS}>
                {S}Server,
                <#END>
            ],
        },
    @END
#END

#BEGIN: "router/index.ts"
    @TSINJECT: ROUTERS_IMPORT
        <#FOR: S in {SERVERS}>
        import { {S}Router } from "../routes/{S}.route";
        <#END>
    @END
    @TSINJECT: ROUTERS_USE
        <#FOR: S in {SERVERS}>
        /** Mounting {S} server router on {SERVERS.{S}.route} */
        router.use("{SERVERS.{S}.route}", {S}Router);
        <#END>
    @END
#END

// 3. FILE GENERATION
#CREATE: "configs/xms.config.ts"
/**
 * XyPriss Multi-Server (XMS) Shared Configuration.
 * This file is automatically generated by the orchestrator.
 */

export const xmsc: XMS_NODE = __sys__.vars.get("xms_nodes");

/**
 * Interface definition for XMS nodes.
 * Ensures type safety when accessing server-specific configurations.
 */
interface XMS_NODE {
    main: {
        id: string;
        port: number;
    };
    auth: {
        id: string;
        port: number;
    };
}
#END

#FOR: S in {SERVERS}
    #CREATE: "servers/{S}.server.ts"
        import { MultiServerConfig } from "xypriss";
        import { xmsc } from "../configs/xms.config";

        /**
         * {S} Server Configuration.
         * Defines the port, ID, and routing prefix for this specific instance.
         */
        export const {S}Server: MultiServerConfig = {
            id: xmsc.{S}.id,
            port: xmsc.{S}.port,
            routePrefix: "{SERVERS.{S}.route}",
            <#IF: {SERVERS.{S}.extra}>
            // Extra security/performance options
            {SERVERS.{S}.extra}
            <#END>
        };
    #END

    #CREATE: "routes/{S}.route.ts"
        import { Router } from "xypriss";

        /**
         * Router for the {S} module.
         * Handles all requests directed to {SERVERS.{S}.route}.
         */
        export const {S}Router = Router();

        {S}Router.get("/", (ctx) => { 
            ctx.body = { 
                status: "success",
                message: "Welcome to the {S} instance", 
                mode: "XMS",
                timestamp: new Date().toISOString()
            }; 
        });
    #END
#END
