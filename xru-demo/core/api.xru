// Module: API Configuration
#LOG: "--- [API] Configuration des services ---"

#SELECT: build

// Création d'un script JS
#CREATE: server.js
const config = {
  port: 8080 // xfpm: PORT
};
console.log("Server running...");
#END

// Mise à jour de la config via chemins profonds
#BEGIN: config.json
  PUSH modules "api"
  SET settings.port 9000
  REMOVE settings.debug
#END

// Patching du script via Regex
#BEGIN: server.js
  ~~ { "8080": "9000" }
#END

#SELECT: ..
#LOG: "--- [API] Terminé ---"
